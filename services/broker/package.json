{
  "name": "aether-broker",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "AETHER token broker and WebSocket relay (Cloudflare Workers)",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "test": "node --test test/*.test.ts",
    "test:worker": "vitest run",
    "build": "wrangler deploy --dry-run --outdir dist",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.9.0",
    "@cloudflare/workers-types": "^5.20261113.1",
    "@types/node": "^22.10.2",
    "typescript": "5.9.3",
    "vitest": "~3.2.0",
    "wrangler": "^4.0.0"
  }
}

# AETHER broker — example environment. Copy to your Deno Deploy secret store.
# NEVER commit real values. Every entry below is either public or a placeholder.

# Public: GitHub App identifiers
AETHER_GITHUB_APP_ID=1234567
AETHER_GITHUB_CLIENT_ID=Iv1.0123456789abcdef

# Secret: generate in the GitHub App settings, store as an encrypted secret
AETHER_GITHUB_CLIENT_SECRET=replace-me

# Secret: paste the PEM contents, newlines as \n
AETHER_GITHUB_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nreplace-me\n-----END RSA PRIVATE KEY-----

# Public: the one repository this broker serves
AETHER_ALLOWED_REPOSITORY=owner/aether-ai-workspace

# Public: must match the OIDC audience requested by the worker workflow
AETHER_RELAY_AUDIENCE=aether-relay

# Optional
AETHER_TICKET_TTL_MS=60000
AETHER_ALLOWED_ORIGINS=
AETHER_VERSION=0.1.0

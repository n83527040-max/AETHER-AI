{
  "name": "aether-broker",
  "version": "0.1.0",
  "tasks": {
    "check": "deno check src/main.ts",
    "test": "deno test --allow-env --allow-net --allow-run test/",
    "dev": "deno run --unstable-kv --allow-net --allow-env --allow-sys src/main.ts"
  },
  "fmt": {
    "lineWidth": 100
  },
  "compilerOptions": {
    "lib": [
      "deno.ns",
      "deno.unstable",
      "esnext",
      "dom",
      "dom.iterable",
      "dom.asynciterable"
    ]
  },
  "exclude": [
    "types/"
  ],
  "exports": "./src/main.ts"
}
